generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  description   String
  costPrice     Float
  salePrice     Float
  stockQuantity Int         @default(0)
  imageUrl      String      @default("https://placehold.co/600x400/e2e8f0/475569?text=Produto")
  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id])
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id            Int         @id @default(autoincrement())
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  city          String
  state         String
  zipCode       String
  paymentMethod String
  status        String      @default("PENDING")
  subtotal      Float
  shipping      Float       @default(0)
  total         Float
  items         OrderItem[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model Admin {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}
